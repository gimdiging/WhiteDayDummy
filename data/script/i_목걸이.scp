Init()
{
	SetObjName("소영이의목걸이");
	SendMessage("", "발광", "Recursive on");
	SendMessage("", "발광색", "Recursive 104 96 23");
}

Init커서용()
{
	SendMessage("", "스크립트설정", "item " + $WorkingFile);
	SetObjValue("Step", 0);
	SetObjName("소영이의목걸이커서용");
	SendMessage("", "페이드", "Recursive 0 0 0");
}

pick()
{
	$Step = GetObjValue("Step");
	
	if($Step == 0)
	{
		return "보기";
	}
	else if($Step == 1)
	{
		return "잡기";
	}
	return "";
}

click()
{
	$Step = GetObjValue("Step");
	
	if($Step == 0)
	{
		SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text54");
	}
	else if($Step == 1)
	{
		GetItem();
	}
	SetObjValue("Step", $Step + 1);
}

GetItem()
{
	SendMessage("소영이의목걸이", "발광", "Recursive off");
	SendMessage("소영이의목걸이", "페이드", "Recursive 1 1 0");
	SendMessage("유저", "획득", "소영이의목걸이");
	SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text55");
	SendMessage("타이머", "스크립트설정", "1 0 1 i_목걸이.Release");
}

Release()
{
	DeleteObject("소영이의목걸이");
	DeleteObject("소영이의목걸이커서용");
}
