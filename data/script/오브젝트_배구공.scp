Init()
{
	SendMessage("", "스크립트설정", "ball " + $WorkingFile);
	SetObjValue("FindEvent", FALSE);
}

pick()
{
	return "보기";
}

click()
{
	if($Mission2_공이벤트 == TRUE)
	{
		if(GetObjValue("FindEvent") == FALSE)
		{
			$Mission2_배구공++;
//			SendMessage("자막", "문자출력", "3," + $Mission2_배구공 + "번째 배구공이다");
			SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text78");
			SendMessage("사운드", "연주", "data/sound/아이템획득.wav");
			
			SetObjValue("FindEvent", TRUE);
		}
		else
		{
			switch(Random() % 3)
			{
				case 0:
				{
//					SendMessage("자막", "문자출력", "2,아까 찾은 공인것 같다");
					SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text70");
					break;
				}
				case 1:
				{
//					SendMessage("자막", "문자출력", "2,또 그공이다... 지겹군...");
					SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text71");
					break;
				}
				case 2:
				{
//					SendMessage("자막", "문자출력", "2,이미 보았던 공이다");
					SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text72");
					break;
				}
			}
		}
	}
	else
	{
//		SendMessage("자막", "문자출력", "2,배구공이다");
		SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text79");
	}
}