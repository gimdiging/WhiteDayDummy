	for($i = 0; $i <= 2; $i++)
	{
		AddScriptFileList($ScriptFolder + "_" + GetValue("$ScriptFileName" + $i) + $ScriptType);
	}

	{
		ChangeScript($ScriptFileName0);		// menu
	//	ChangeScript($ScriptFileName1);		// main1
	//	ChangeScript($ScriptFileName2);		// main2
	}
}
