Init()
{
	SendMessage("", "스크립트설정", "handle " + $WorkingFile);
}

pick()
{
	return "잡기";
}

click()
{
	switch(Random() % 2)
	{
		case 0:
		{
			$Info = "It's locked";
			break;
		}
		case 1:
		{
			$Info = "You can't open it";
			break;
		}
	}

//	SendMessage("자막", "문자출력", "2," + $Info);
	if($Info == "It's locked")
	{
		SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text21");
	}
	else if($Info == "You can't open it")
	{
		SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text06");
	}
	SendMessage("사운드", "연주", "당기는문잠긴것,data/sound/돌리는문잠긴것.wav");
}