Init()
{
	SendMessage("", "스크립트설정", "use1 " + $WorkingFile + ".Ladder잡기");		// 잡기
	SendMessage("", "스크립트설정", "use2 " + $WorkingFile + ".Ladder오르기1");		// 오르기1
	SendMessage("", "스크립트설정", "use5 " + $WorkingFile + ".Ladder오르기2");		// 오르기2
	SendMessage("", "스크립트설정", "use3 " + $WorkingFile + ".Ladder내려오기1");	// 내려오기1
	SendMessage("", "스크립트설정", "use4 " + $WorkingFile + ".Ladder내려오기2");	// 내려오기2
	SendMessage("", "스크립트설정", "dummy1 " + "null");
	SendMessage("", "스크립트설정", "dummy2 " + "null");

	SetObjValue("Step", 0);
	SetObjName("작업용사다리");
}

Ladder잡기.pick()
{
	if($USER_CAPTUREITEM == FALSE && $USER_RISE == OFF)
	{
		return GetObjValue("Step") == 0 ? "보기" : "잡기";
	}
	return "";
}

Ladder잡기.click()
{
	if(ShowInfo() == FALSE && $USER_RISE == OFF && $USER_CAPTUREITEM == FALSE)
	{
		$USER_CAPTUREITEM = TRUE;
		SendMessage("유저", "캡춰", "작업용사다리 팔");
		SendMessage("사운드", "연주", "당기는문잠긴것,data/sound/사다리들기.wav");
	}
}

Ladder오르기1.pick()
{
	if($USER_CAPTUREITEM == FALSE && $USER_RISE == OFF)
	{
		return GetObjValue("Step") == 0 ? "보기" : "사다리오르기";
	}
	return "";
}

Ladder오르기1.click()
{
	if(ShowInfo() == FALSE && $USER_RISE == OFF && $USER_CAPTUREITEM == FALSE)
	{
		$USER_RISE = ON;
		SetObjValue("Case", 1);
		SendMessage("유저", "이동제한", "on");
		SendMessage("유저", "오르기", "작업용사다리 머리");
	}
}

Ladder오르기2.pick()
{
	if($USER_CAPTUREITEM == FALSE && $USER_RISE == OFF)
	{
		return GetObjValue("Step") == 0 ? "보기" : "사다리오르기";
	}
	return "";
}

Ladder오르기2.click()
{
	if(ShowInfo() == FALSE && $USER_RISE == OFF && $USER_CAPTUREITEM == FALSE)
	{
		$USER_RISE = ON;
		SetObjValue("Case", 2);
		SendMessage("유저", "이동제한", "on");
		SendMessage("유저", "오르기", "작업용사다리 머리");
	}
}

Ladder내려오기1.pick()
{
	return ($USER_RISE == ON && GetObjValue("Case") == 1) ? "사다리내려오기" : "";
}

Ladder내려오기1.click()
{
	if($USER_RISE == ON && $USER_CAPTUREITEM == FALSE && GetObjValue("Case") == 1)
	{
		$USER_RISE = OFF;
		SendMessage("유저", "이동제한", "off");
		SendMessage("유저", "내려오기", "");
	}
}

Ladder내려오기2.pick()
{
	return ($USER_RISE == ON && GetObjValue("Case") == 2) ? "사다리내려오기" : "";
}

Ladder내려오기2.click()
{
	if($USER_RISE == ON && $USER_CAPTUREITEM == FALSE && GetObjValue("Case") == 2)
	{
		$USER_RISE = OFF;
		SendMessage("유저", "이동제한", "off");
		SendMessage("유저", "내려오기", "");
	}
}

ShowInfo()
{
	$Step = GetObjValue("Step");
	if($Step == 0)
	{
//		SendMessage("자막", "문자출력", "2,It's a ladder. You can climb up using it");
		SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text92");
		SetObjValue("Step", $Step + 1);
		return TRUE;
	}
	return FALSE;
}
