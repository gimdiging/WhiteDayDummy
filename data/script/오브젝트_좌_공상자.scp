Init()
{
	SendMessage("", "스크립트설정", "info " + $WorkingFile);
}

Init배구공()
{
	Init();
	SetObjValue("InfoText", "배구공이 4개 있다");
}

Init농구공()
{
	Init();
	SetObjValue("InfoText", "농구공이 3개 있다");
}

pick()
{
	return "보기";
}
	
click()
{
//	SendMessage("자막", "문자출력", "3," + GetObjValue("InfoText"));
	$InfoText = GetObjValue("InfoText");
	
	if($InfoText == "배구공이 4개 있다")
	{
		SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text94");
	}
	else if($InfoText == "농구공이 3개 있다")
	{
		SendMessage("타이머", "스크립트설정", "0 0 1 _langtable.Text95");
	}
}
